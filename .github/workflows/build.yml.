name: Build
on:
  push:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '25'
      - run: unzip -o Economie-Plugin-Source.zip -d projet
      - run: mvn -B package
        working-directory: projet
      - uses: actions/upload-artifact@v4
        with:
          name: Economie
          path: projet/target/Economie.jar
